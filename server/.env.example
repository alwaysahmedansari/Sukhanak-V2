# Copy this file to ".env" (same folder) and fill in your own values.
PORT=8000
DEV=true

# Free database from TiDB Cloud (see README, "Database").
# In TiDB Cloud open your instance, click "Connect" and copy these values.
TIDB_HOST=gateway01.REGION.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=YOUR_PREFIX.root
TIDB_PASSWORD=your-database-password
TIDB_DATABASE=sukhanak
# Keep true for TiDB Cloud. Use false only for a local MySQL without TLS.
TIDB_SSL=true

# Any long random text. Use two DIFFERENT values.
JWT_SECRET=change-me-to-a-long-random-text
JWT_REFRESH_SECRET=change-me-to-another-long-random-text

# Address of the website (frontend)
CLIENT_URL=http://localhost:5173

# Google sign-in (see README, "Google sign-in")
clientid=
clientsecret=
redirect_url=http://localhost:8000/auth/google/oauth
